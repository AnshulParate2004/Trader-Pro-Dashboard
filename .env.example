# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.ilejs4x.mongodb.net/that?retryWrites=true&w=majority

# Authentication & Session Security
# 32+ character random secret used by jose to sign and encrypt JWT session cookies
AUTH_SECRET=your_32_plus_character_random_hex_secret

# Authorized admin account
AUTH_EMAIL=anshulnparate@gmail.com

# Admin password: Set either AUTH_PASSWORD_HASH (recommended bcrypt hash) or AUTH_PASSWORD (raw string)
AUTH_PASSWORD_HASH=your_bcrypt_hash_here
# AUTH_PASSWORD=your_secure_password_here

# Cron Security Token (Required by GitHub Actions cloud-cron runner)
CRON_SECRET=your_cron_secret_token_here

# Trading Engine Configuration (Shark Exchange Taker Fee: 0.040%)
DEFAULT_TRADING_FEE_PERCENT=0.040
NEXT_PUBLIC_APP_URL=http://localhost:3000
