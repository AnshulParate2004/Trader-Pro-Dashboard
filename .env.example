# MongoDB Atlas Connection String (Placeholders only - never commit real connection URIs)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>.mongodb.net/<database_name>?retryWrites=true&w=majority

# Authentication & Session Security (Required in production)
# 32+ character cryptographically secure secret used to sign and verify JWT session cookies
AUTH_SECRET=your_32_plus_character_random_hex_secret

# Authorized administrative quantitative account email
AUTH_EMAIL=your_admin_email@example.com

# Admin password hash: Store a salted bcrypt hash (generated via bcrypt.hashSync(pass, 10))
# NOTE ON NEXT.JS DOTENV-EXPAND:
# Next.js processes .env.local with dotenv-expand. Because bcrypt hashes contain '$' (e.g. $2a$ or $2b$),
# unescaped '$' is interpreted as an environment variable expansion and wiped to empty string.
# - For local .env.local: Escape every '$' with a backslash and wrap in quotes:
#   AUTH_PASSWORD_HASH="\$2b\$10\$[placeholder_53_base64_chars]"
# - For Vercel Project Settings (Production): Vercel does NOT expand '$', so paste raw without backslashes:
#   AUTH_PASSWORD_HASH=$2b$10$[placeholder_53_base64_chars]
AUTH_PASSWORD_HASH="\$2b\$10\$placeholder_salt_and_hash_53_chars_length_60"

# Cron Bearer Security Token (Required by GitHub Actions cloud-cron runner)
CRON_SECRET=your_cron_secret_token_here

# Trading Engine Configuration (CoinSwitch Pro Futures Taker Fee: 0.065%)
DEFAULT_TRADING_FEE_PERCENT=0.065
NEXT_PUBLIC_APP_URL=http://localhost:3000
