# MongoDB Atlas Connection String (Placeholders only - never commit real connection URIs)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>.mongodb.net/<database_name>?retryWrites=true&w=majority

# Authentication & Session Security (Required in production)
# 32+ character cryptographically secure secret used to sign and verify JWT session cookies
AUTH_SECRET=your_32_plus_character_random_hex_secret

# Authorized administrative quantitative account email
AUTH_EMAIL=anshulnparate@gmail.com

# Admin password hash: Store a bcrypt hash (e.g. generated via bcrypt.hashSync(pass, 10))
AUTH_PASSWORD_HASH=your_bcrypt_hash_here

# Cron Bearer Security Token (Required by GitHub Actions cloud-cron runner)
CRON_SECRET=your_cron_secret_token_here

# Trading Engine Configuration (Shark Exchange Taker Fee: 0.040%)
DEFAULT_TRADING_FEE_PERCENT=0.040
NEXT_PUBLIC_APP_URL=http://localhost:3000
